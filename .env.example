# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# Read only from lib/server/* or route handlers under app/api/*.

# Anthropic API key used by the classifier, answer, and Socratic route handlers.
ANTHROPIC_API_KEY=

# Cloud sync (VOL-195). Opt-in only; OFF by default in the UI.
# SYNC_BACKEND selects the sync adapter. "memory" is the in-process dev stub
# (NOT durable; resets on cold start) and is the default. "supabase" wires up
# the production adapter; that adapter is a stub in this build — see
# lib/server/sync/supabase-adapter.ts and docs/cloud-sync.md before enabling.
SYNC_BACKEND=memory

# Supabase credentials. Only required when SYNC_BACKEND=supabase. Server-only.
# Service role bypasses RLS; treat as the same trust class as ANTHROPIC_API_KEY.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE=
